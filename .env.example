# Copy this file to .env.local and fill in real values. Never commit .env.local.
# These are server-only variables: do NOT prefix them with NEXT_PUBLIC_,
# or Next.js would copy them into browser code.

# CricketData.org (CricAPI) — free key from https://cricketdata.org/
CRICKET_API_KEY=

# football-data.org — free key from https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# Optional: public site address for SEO links (sitemap, metadata). On Vercel
# this is detected automatically; set it only for a custom domain.
SITE_URL=
